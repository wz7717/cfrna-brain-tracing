# BrainTrace full manuscript reproduction container
#
# Build: docker build -f Dockerfile.repro -t braintrace-repro:v0.1.16 .
# Smoke: docker run --rm braintrace-repro:v0.1.16 --help
# Full:  docker run --rm --mount type=bind,src=/absolute/external_data,dst=/workspace/external_data,readonly \
#          braintrace-repro:v0.1.16 --verify-only

FROM python:3.11.9-slim-bookworm

ARG BRAINTRACE_VERSION=0.1.16
LABEL org.opencontainers.image.title="BrainTrace full reproduction"
LABEL org.opencontainers.image.description="Strict manuscript reproduction gate; external data are mounted read-only"
LABEL org.opencontainers.image.version="${BRAINTRACE_VERSION}"
LABEL org.opencontainers.image.source="https://github.com/wz7717/cfrna-brain-tracing"

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin braintrace
WORKDIR /workspace

COPY requirements_reproducible.txt requirements-repro.txt pyproject.toml README.md ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements_reproducible.txt

# The .dockerignore excludes all raw, controlled and patient-level input.
COPY --chown=braintrace:braintrace . .
RUN python -m pip install -e .

USER braintrace
VOLUME ["/workspace/external_data"]

ENTRYPOINT ["python", "reproduce_all.py"]
CMD ["--help"]
